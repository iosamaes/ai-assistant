{
  "name": "mizan",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace @mizan/app run start",
    "web": "npm --workspace @mizan/app run web",
    "android": "npm --workspace @mizan/app run android",
    "ios": "npm --workspace @mizan/app run ios",
    "export:web": "npm --workspace @mizan/app run export:web",
    "report:web-size": "node scripts/report-expo-static-size.mjs apps/app/dist",
    "export:android": "npm --workspace @mizan/app run export:android",
    "export:ios": "npm --workspace @mizan/app run export:ios",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "supabase test db --local",
    "lint:db": "supabase db lint --local --level warning --fail-on error",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "playwright test",
    "test:e2e:mutations": "node scripts/run-e2e-mutations.mjs",
    "test:e2e:visual": "node scripts/run-e2e-visual.mjs",
    "test:e2e:performance": "node scripts/run-e2e-performance.mjs",
    "test:e2e:production": "playwright test tests/e2e/production-web.spec.ts --config=playwright.production.config.ts",
    "test:e2e:production:performance": "node scripts/run-e2e-production-performance.mjs",
    "test:e2e:delete-account": "node scripts/run-e2e-delete-account.mjs",
    "check:runtime": "npm run check && npm run test:e2e",
    "check:release:baseline": "node scripts/run-release-baseline.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "react": "19.2.3",
    "react-test-renderer": "19.2.3"
  }
}
