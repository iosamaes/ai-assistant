{
  "name": "mizan",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace @mizan/app run start",
    "web": "npm --workspace @mizan/app run web",
    "android": "npm --workspace @mizan/app run android",
    "ios": "npm --workspace @mizan/app run ios",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "playwright test",
    "test:e2e:mutations": "playwright test tests/e2e/product-live.spec.ts tests/e2e/onboarding-live.spec.ts tests/e2e/notification-preferences-live.spec.ts --project=desktop-light",
    "test:e2e:visual": "playwright test tests/e2e/visual-evidence-live.spec.ts",
    "test:e2e:performance": "playwright test tests/e2e/performance-live.spec.ts --project=desktop-light",
    "test:e2e:delete-account": "playwright test tests/e2e/account-deletion-live.spec.ts --project=desktop-light",
    "check:runtime": "npm run check && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "react": "19.2.3",
    "react-test-renderer": "19.2.3"
  }
}
