# Public client configuration only. Never place a service-role or secret key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Playwright live-account verification. Individual specs may skip when these are absent, but any configured live URL is fail-closed to the authorized project https://olfhjnropdrnujgpidfi.supabase.co. Live E2E accepts only anon/publishable client credentials; Supabase sb_secret_ keys and legacy service_role JWTs are rejected before the Web server starts. check:release:baseline requires the public client values plus three distinct accounts: completed English, completed Arabic, and incomplete onboarding. The release baseline rejects reused fixture emails. Keep real credentials out of source control.
MIZAN_E2E_SUPABASE_URL=
MIZAN_E2E_SUPABASE_PUBLISHABLE_KEY=
# Completed account used by the normal live matrix. Keep its saved MIZAN profile locale English when collecting CP9 English visual evidence.
MIZAN_E2E_COMPLETED_EMAIL=
MIZAN_E2E_COMPLETED_PASSWORD=
# Separate completed account whose saved MIZAN profile locale is Arabic; used for read-only RTL matrix coverage.
MIZAN_E2E_ARABIC_EMAIL=
MIZAN_E2E_ARABIC_PASSWORD=
# Separate intentionally incomplete account used by the onboarding matrix.
MIZAN_E2E_ONBOARDING_EMAIL=
MIZAN_E2E_ONBOARDING_PASSWORD=
# Dedicated completed account used only by the irreversible deletion E2E; not required by the non-destructive release baseline.
MIZAN_E2E_DELETE_EMAIL=
MIZAN_E2E_DELETE_PASSWORD=
# Set only when the configured accounts are disposable/dedicated test accounts.
MIZAN_E2E_MUTATIONS=0
# Explicit opt-in for CP9 screenshot capture across the configured responsive/light-dark Playwright matrix.
MIZAN_E2E_VISUAL_EVIDENCE=0
# Explicit opt-in shared by the read-only controlled-runtime and production-static-export performance sanity samples.
MIZAN_E2E_PERFORMANCE=0
# Separate irreversible opt-in. The deletion account is permanently removed when enabled.
MIZAN_E2E_DESTRUCTIVE=0
